# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # solo servidor, nunca en el navegador

# --- URL pública de la app (sin / final) ---
NEXT_PUBLIC_APP_URL=https://estimates.all4kloud.net

# --- Email (Resend) ---
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=estimates@all4kloud.net  # dominio verificado en Resend

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_...
# Connect: los negocios cobran a SUS clientes (webhook "Events on connected accounts")
STRIPE_WEBHOOK_SECRET=whsec_...
PLATFORM_FEE_PERCENT=0                     # comisión opcional de la plataforma por pago
# Billing: los negocios le pagan la suscripción a all4kloud (webhook "Events on your account")
STRIPE_BILLING_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...                  # precio recurrente anual de $100
TRIAL_DAYS=14                              # 0 = sin prueba gratis
PLAN_PRICE_LABEL=$100                      # cómo se muestra el precio en registro y suscripción
